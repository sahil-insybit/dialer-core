# Copy this file to ".env" and paste your real values.
#
# 1. Create a free account at https://cloudinary.com/users/register_free
# 2. On your Cloudinary Dashboard you'll see "Cloud name", "API Key", "API Secret".
# 3. Paste them below (in the .env file, NOT this example file).

CLOUDINARY_CLOUD_NAME=paste_your_cloud_name_here
CLOUDINARY_API_KEY=paste_your_api_key_here
CLOUDINARY_API_SECRET=paste_your_api_secret_here

# Port the API listens on (leave as-is unless it clashes with something).
PORT=3001

# Optional: a shared secret the app must send in the "x-api-key" header.
# Leave blank to disable auth while testing. Set a value later for a bit of protection.
API_KEY=
